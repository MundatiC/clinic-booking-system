# Copy to .env for local (non-docker) runs. Never commit .env.
ENVIRONMENT=local
LOG_LEVEL=INFO
# Matches `docker compose up db` (host port 5433).
DATABASE_URL=postgresql+psycopg://clinic:clinic@localhost:5433/clinic
# Tests create and use this database (it is dropped/recreated by the test suite).
TEST_DATABASE_URL=postgresql+psycopg://clinic:clinic@localhost:5433/clinic_test

CLINIC_TIMEZONE=Africa/Nairobi
SLOT_MINUTES=30
MIN_LEAD_TIME_MINUTES=60
MAX_ADVANCE_DAYS=90

# Comma-separated explicit origins; "*" is rejected.
CORS_ORIGINS=http://localhost:8000
RATE_LIMIT_WRITES=30/minute
RATE_LIMIT_ENABLED=true
MAX_BODY_BYTES=16384

# Container entrypoint switches (used by docker compose / Render).
RUN_MIGRATIONS_ON_START=false
RUN_SEED_ON_START=false

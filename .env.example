# Copy to .env for local (non-docker) runs. Never commit .env.
ENVIRONMENT=local
LOG_LEVEL=INFO
# Matches `docker compose up db` (host port 55432).
DATABASE_URL=postgresql+psycopg://clinic:clinic@localhost:55432/clinic
# Tests create and use this database (it is dropped/recreated by the test suite).
TEST_DATABASE_URL=postgresql+psycopg://clinic:clinic@localhost:55432/clinic_test

CLINIC_TIMEZONE=Africa/Nairobi
SLOT_MINUTES=30
MIN_LEAD_TIME_MINUTES=60
MAX_ADVANCE_DAYS=90

# Comma-separated explicit origins; "*" is rejected.
CORS_ORIGINS=http://localhost:8000
RATE_LIMIT_WRITES=30/minute
RATE_LIMIT_ENABLED=true
MAX_BODY_BYTES=16384

# Public origin (links in emails; trusted Origin for cookie-authenticated writes).
PUBLIC_BASE_URL=http://localhost:8000
CLINIC_NAME=The Clinic
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12
RATE_LIMIT_AUTH=10/minute
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
# Optional staff account created by the seed. Leave empty in the repo.
STAFF_EMAIL=
STAFF_PASSWORD=

# Email. Local: Mailpit from docker compose (inbox at http://localhost:8025).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=The Clinic <no-reply@clinic.localhost>
# Production with Resend (SMTP relay):
#   SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_SECURITY=ssl
#   SMTP_USER=resend  SMTP_PASSWORD=<RESEND_API_KEY>  MAIL_FROM=Clinic <bookings@your-verified-domain>

# Container entrypoint switches (used by docker compose / Render).
RUN_MIGRATIONS_ON_START=false
RUN_SEED_ON_START=false
